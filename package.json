{
  "name": "harness-lab-back",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --watch src/index.ts",
    "start": "bun src/index.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/index.ts --compile --minify --target=bun-linux-x64 --outfile dist/harness-lab-back",
    "build:local": "bun build src/index.ts --compile --minify --outfile dist/harness-lab-back-local"
  },
  "dependencies": {
    "hono": "4.13.19"
  },
  "devDependencies": {
    "@types/bun": "1.4.4",
    "typescript": "7.0.2"
  }
}
