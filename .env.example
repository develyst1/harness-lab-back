# Every key is optional for local use; the defaults below are what the server uses when a key is unset.
# Port the server listens on, a whole number from 1 to 65535 (default 4101). Anything else stops the server at start.
PORT=4101
# Address the server binds to (default 127.0.0.1; keep it behind nginx on a server).
HOST=127.0.0.1
# The one origin allowed by CORS, i.e. the front's URL (default http://localhost:4100).
# Exactly scheme://host[:port], no trailing slash, no list, never "*"; anything else stops the server at start.
CORS_ORIGIN=http://localhost:4100
# Folder holding runs.json, tiers.json, meta.json, page.json and techniques.json, read on every request (default ./data, relative to the working directory).
DATA_DIR=./data
# Absolute path of the harness-lab-clips folder (outside git) that /clips/<file> serves from; no default: unset = no clips.
CLIPS_DIR=
